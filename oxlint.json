{
  "plugins": ["typescript", "react"],
  "rules": {
    "correctness": "error",
    "perf": "warn",
    "no-debugger": "error",
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "react/jsx-key": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "myGlobalVar": "readonly"
  }
}